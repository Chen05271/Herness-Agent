# ══════════════════════════════════════════════════════════
#  LLM 配置 — 三选一（取消注释对应区块即可）
# ══════════════════════════════════════════════════════════

# ── 方案 A：本地 vLLM（OpenAI 兼容）──
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=dummy
LLM_MODEL=default

# ── 方案 B：OpenAI 官方 API ──
# LLM_PROVIDER=openai
# LLM_BASE_URL=
# LLM_API_KEY=sk-your-openai-key
# LLM_MODEL=gpt-4o-mini

# ── 方案 C：DeepSeek（OpenAI 兼容，改 base_url 即可）──
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-deepseek-key
# LLM_MODEL=deepseek-chat

# ── 方案 D：Moonshot / Kimi ──
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_API_KEY=sk-your-moonshot-key
# LLM_MODEL=moonshot-v1-8k

# ── 方案 E：Anthropic Claude 官方 API ──
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=
# LLM_API_KEY=sk-ant-your-key
# LLM_MODEL=claude-sonnet-4-6

# ── 方案 F：阿里百炼 DashScope（推荐）──
# 对应 Spring langchain4j.community.dashscope 配置：
#   streaming-chat-model.model-name=qwen3.7-max
#   embedding-model.model-name=text-embedding-v3
# DASHSCOPE_API_KEY=sk-your-dashscope-key
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen3.7-max
# Qwen3.7 等混合思考模型在 DashScope 上默认开启 thinking，与 Agent 结构化输出不兼容；
# 留空则自动关闭。若需深度推理可设为 true（但 function calling 可能失败）：
# LLM_ENABLE_THINKING=false
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# HERENESS_VECTOR_ENABLED=true
# API_PORT=8090

# ── Agent 温度 ──
SUPERVISOR_TEMPERATURE=0.0
WORKER_TEMPERATURE=0.3
CRITIC_TEMPERATURE=0.0

# ── 调度器防护 ──
MAX_ROUNDS=8
STEP_TIMEOUT_SECONDS=120
TASK_TIMEOUT_SECONDS=600
MAX_RETRIES_PER_STEP=2
# SESSION_HISTORY_LIMIT=5

# ── HTTP API ──
# API_PORT=8090
# API_KEY=your-secret-key
# RATE_LIMIT_PER_USER=30
# RATE_LIMIT_WINDOW_SECONDS=60

# ── 数据库 ──
# 留空则使用 InMemoryMiddleware；填写后 API 自动切换 PostgresMiddleware
# POSTGRES_DSN=postgresql://herness:herness@localhost:5432/herness
POSTGRES_DSN=
# 无密码默认端口：redis://localhost:6379
REDIS_URL=
# REDIS_MEMORY_TTL_SECONDS=3600
# REDIS_TASK_TTL_SECONDS=86400

# ── 离线管线 ──
DREAMING_ENABLED=true
# DREAMING_TEMPERATURE=0.2
# DREAMING_POLL_TIMEOUT_SECONDS=5
# DREAMING_MAX_RETRIES=3
# DREAMING_RETRY_BACKOFF_SECONDS=2
HERENESS_ENABLED=true
# Hereness v2 向量语义检索（需 Postgres 安装 pgvector 扩展）
# HERENESS_VECTOR_ENABLED=true
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# HERENESS_VECTOR_TOP_K=10
# HERENESS_VECTOR_MIN_SIMILARITY=0.5
# HERENESS_CONFLICT_DECAY_FACTOR=0.5
# HERENESS_SUPERSEDED_THRESHOLD=0.3

# ── RAG 知识库 ──
# RAG_ENABLED=true
# RAG_VECTOR_ENABLED=true
# RAG_GREP_ENABLED=true
# RAG_GRAPH_ENABLED=true
# RAG_COMMUNITY_ENABLED=true
# RAG_RERANK_ENABLED=true
# RAG_COARSE_TOP_K=80
# RAG_FINE_TOP_K=20
# RAG_FINAL_TOP_K=5
# RAG_VECTOR_MIN_SIMILARITY=0.3
# RAG_FTS_MIN_RANK=0.01
# RAG_RERANK_MODEL=
# RAG_INGEST_CHUNK_SIZE=512
# RAG_INGEST_CHUNK_OVERLAP=64

# ── 可观测性 ──
# STRUCTURED_LOGGING=true
# METRICS_ENABLED=true
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=herness-agent
# OTEL_EXPORTER=otlp_http
# OTEL_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_INSECURE=true
# OTEL_INSTRUMENT_HTTPX=true

# ── Worker 外部工具 ──
# WORKER_TOOLS_HTTP_ENABLED=true
# WORKER_TOOLS_HTTP_MAX_BYTES=65536
# WORKER_TOOLS_FILE_ENABLED=false
# WORKER_TOOLS_FILE_BASE_DIR=
# WORKER_TOOLS_FILE_MAX_BYTES=65536
# WORKER_TOOLS_CODE_ENABLED=false
# WORKER_TOOLS_CODE_TIMEOUT_SECONDS=10

# ── 智慧农业电商 BFF（mock 开发 / http 对接真实 API）──
# AGRI_COMMERCE_ENABLED=true
# AGRI_COMMERCE_MODE=http
# AGRI_COMMERCE_BASE_URL=http://localhost:8080/v1
# AGRI_COMMERCE_API_KEY=
# AGRI_COMMERCE_ADMIN_TOKEN=
# AGRI_COMMERCE_TIMEOUT_SECONDS=30
